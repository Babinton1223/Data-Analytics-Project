	measure Maxvalue = 60
		formatString: 0
		lineageTag: 51caf59e-ea0a-4cc6-b77e-5e51507bb62b

	measure Left_value_pM10 = [Maxvalue]- SUM(Current__Day_Weather[current.air_quality.pm10])
		lineageTag: 175b5de7-c19b-4fe7-80c8-f66392e8d662

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AQI status text' = ```
			
			Var AQI =ROUND(SELECTEDVALUE(Current__Day_Weather[current.air_quality.pm10]),0)
			return 
			      SWITCH(
			        TRUE(),
			        AQI<=10,"Good",
			        AQI<=20,"Moderate",
			        AQI<=30,"Unhealthy for sensitive",
			        AQI<=40,"Unsafe",
			        AQI<=50,"Hazardous",
			        "Immediate action needed"
			      )
			```
		displayFolder: AQI Color/Sugg/Status
		lineageTag: bdddaaf5-8203-4996-9bd5-f18b4a8f6051

	measure 'AQI suggestion PM10' = ```
			
			Var AQI =ROUND(SELECTEDVALUE(Current__Day_Weather[current.air_quality.pm10]),0)
			return 
			      SWITCH(
			        TRUE(),
			        AQI<=10,"Air is clean and Healthy",
			        AQI<=20,"Acceptable air quality, stay active",
			        AQI<=30,"Sensitive people should reduce outdoor activities",
			        AQI<=40,"Limit prolonged outdoor exertion",
			        AQI<=50,"Avoid outdoor activity",
			        "Stay indoor and wear masks"
			      )
			```
		displayFolder: AQI Color/Sugg/Status
		lineageTag: 3d92d2db-f9ea-456a-9714-431adc5d0800

	measure Humidity = SUM(Current__Day_Weather[current.humidity])&" %"
		lineageTag: ab9183cb-5cf0-4ca2-ad84-3984928c6b2d

	measure Pressure = SUM(Current__Day_Weather[current.pressure_in])& " mm"
		lineageTag: 8ebd777e-2ad5-404a-b48c-09f75f1b7d85

	column 'location.name'
		lineageTag: 6b4dc551-0edf-42b0-8b84-c88677bc499b
		summarizeBy: none
		isNameInferred
		sourceColumn: Locations[location.name]

		annotation SummarizationSetBy = Automatic

	partition Measures_table = calculated
		mode: import
		source = SUMMARIZE(Current__Day_Weather,Locations[location.name])

	annotation PBI_Id = 809032ece56c46b4b996f4e599c13d49

