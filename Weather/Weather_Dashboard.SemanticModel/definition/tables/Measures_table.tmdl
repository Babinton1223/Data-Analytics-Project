table Measures_table
	lineageTag: bd550d57-309e-4a24-9620-dee2b04b68e9

	measure Cur_temp_Celcius = SUM(Current__Day_Weather[current.temp_c])&" °C"
		lineageTag: 76e8aa23-fdcf-4a11-8916-29f010cdce23

	measure Cur_Last_Updated_time = "Last_Updated"&" "&FORMAT(FIRSTNONBLANK(Current__Day_Weather[current.last_updated].[Date],""),"dd mmm yy")
		lineageTag: 1726eef4-e3c0-441b-b6c1-4437ade64611

	measure Wind_Kph = SUM(Current__Day_Weather[current.wind_kph])&" Kph"
		lineageTag: 1776d3b3-ab41-4f4c-b665-ebfdb6ce18ac

	measure Visibility_kph = SUM(Current__Day_Weather[current.vis_km])&" Km"
		lineageTag: 205009c5-adba-4da9-94d1-cfdfe0fa6fb0

	measure For_Temp_Celcius = AVERAGE(Forecast_Day_Weather[forecast.forecastday.day.avgtemp_c])&" °C"
		lineageTag: ae9b7379-969e-46b6-ab84-9c4457bfcb02

	measure 'AQI color PM10' = ```
			
			Var AQI =ROUND(SELECTEDVALUE(Current__Day_Weather[current.air_quality.pm10]),0)
			return 
			      SWITCH(
			        TRUE(),
			        AQI<=10,"#43d946", --Good (Green)
			        AQI<=20,"#fff570", --Moderate (Yellow)
			        AQI<=30,"#ff9800", --Poor (Orange)
			        AQI<=40,"#d99343", --Unhealthy (Red)
			        AQI<=50,"#ff5b0f", -- Severe (Purple)
			        "#d95243"            -- Hazardous (Dark Maroon)
			      )
			```
		displayFolder: AQI Color/Sugg/Status
		lineageTag: 06b9f97a-c658-4e70-8c01-98cb2c2c166f

