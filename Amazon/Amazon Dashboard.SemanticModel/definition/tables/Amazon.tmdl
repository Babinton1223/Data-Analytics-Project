table Amazon
	lineageTag: 85277afb-a1c6-4086-961b-68059b6a44b3

	measure Sales_Amount = SUM(Amazon[Total_Amount])
		lineageTag: 272a1f25-72ce-4405-9f01-06aa4b6c0451

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sales_Units = SUM(Amazon[Qty])
		formatString: 0
		lineageTag: a6bb6610-03c6-4b84-9c15-ba965a56cc95

	measure Filter_Sales =
			var _select = SELECTEDVALUE(Sale_Option[Type])
			Return IF(_select="1",[Sales_Amount],[Sales_Units])
		lineageTag: 2380fae2-20ec-43b3-b683-307adbd20e0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Overall_Sales = CALCULATE([Filter_Sales],ALL('amazon-fashion - YT'[Category]))
		lineageTag: 793b4072-ee90-4388-b145-02045b32eaf3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Return = if([Sales_Units]=BLANK(),"0",[Sales_Units])
		lineageTag: 976f97e7-a0cf-4770-b530-200c0e05a7f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sale_units_measure = IF([Sales_Units]=BLANK(),"0",[Sales_Units])
		lineageTag: e53e3837-4bcc-4ba5-8b0e-6b9662f6d731

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Sale_amount_measure = IF([Sales_Amount]=BLANK(),"0",[Sales_Amount])
		lineageTag: 19297324-29cc-4a47-9334-dfa30ed267b4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic city' =
			var _title = (SELECTEDVALUE(Sale_Option[Name]))
			return if(_title = "Sales","Sales by City","Units Sold by City")
		lineageTag: b06f4beb-b957-4dcf-a1d5-b09aa72756ad

	measure 'Dynamic State' =
			var _title = (SELECTEDVALUE(Sale_Option[Name]))
			return if(_title = "Sales","Sales by State","Units Sold by State")
		lineageTag: 1048bf88-78d4-46d4-9961-3fcba9fee28f

	measure 'Dynamic date' =
			var _title = (SELECTEDVALUE(Sale_Option[Name]))
			return if(_title = "Sales","Sales by Date","Units Sold by Date")
		lineageTag: a2954fac-fe81-4498-8705-a2d7203f0345

	measure 'Dynamic sales' =
			var Card = SELECTEDVALUE(Sale_Option[Name])
			return if (Card="Sales","Sales_Amount","Units Sold")
		lineageTag: f61429ab-24e8-410b-8d82-d8bd8ff9b393

	measure 'Dynamic overall' =
			var overall = SELECTEDVALUE(Sale_Option[Name])
			return if (overall="Sales","Overall_Sales","Overall_Units")
		lineageTag: 89da9f8e-705b-4965-85b8-e19a540fcac8

