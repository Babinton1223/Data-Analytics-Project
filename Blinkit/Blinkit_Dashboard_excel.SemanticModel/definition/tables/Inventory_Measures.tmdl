table Inventory_Measures
	lineageTag: 37a8d987-45d9-4d4d-b1c9-441584a766eb

	/// Autogenerated description for measure 'Inventory_Value'.
	measure Inventory_Value = SUM(Inventory[Value])
		lineageTag: 86c63a30-21ef-4290-97aa-5d30ceb1bfd4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Inventory_YTD'.
	measure Inventory_YTD =
			VAR ytd_sys_month = [YTD_Month]
					RETURN
						CALCULATE(
							[Inventory_Value],
							'Calendar'[MonthIndex] <= ytd_sys_month
						)
		lineageTag: 729b6468-e4f0-42b2-9873-dccca47d52f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Stock_received'.
	measure Stock_received =
			CALCULATE(
						[Period_Inventory_Value],
						Inventory[Stock_Type] = "stock_received"
					)
		lineageTag: 7384811b-7a35-4966-ba51-dae4da7d86d7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Stock_damaged'.
	measure Stock_damaged =
			CALCULATE(
						[Period_Inventory_Value],
						Inventory[Stock_Type] = "damaged_stock"
					)
		lineageTag: 03717985-64a0-4d56-b9be-933ec9a7bfe4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Instock'.
	measure Instock = [Period_Inventory_Value] - [Period_Value]
		lineageTag: 43edcae1-41b1-4aad-a226-f4d6f01e7038

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Sold_Stock_%'.
	measure Sold_Stock_% =
			DIVIDE(
						[Period_Value],
						[Period_Inventory_Value]
					)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3a838354-9511-4536-b156-536c8bb2a3b8

	/// Autogenerated description for measure 'Instock_%'.
	measure Instock_% =
			DIVIDE(
						[Instock],
						[Period_Inventory_Value]
					)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c5a1ab8c-a752-450e-b409-552bcfea2136

	/// Autogenerated description for measure 'Damaged_Stock_%'.
	measure Damaged_Stock_% =
			DIVIDE(
						[Stock_damaged],
						[Period_Inventory_Value]
					)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0ceb91ea-79c1-40a5-8b43-6159b92fc016

	column Column
