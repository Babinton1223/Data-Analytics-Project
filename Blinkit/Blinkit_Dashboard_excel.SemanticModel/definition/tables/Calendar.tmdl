	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(CALENDAR("1/1/"&[Previous_Year],"31/12/"&[Current_Year]),
				"Year",YEAR([Date]),
				"Month",FORMAT([Date],"mmm"),
				"Month-Yr",FORMAT([Date],"mmm-yy"),
				"Day",FORMAT([Date],"ddd"),
				"MonthIndex",MONTH([Date]),
				"Quater","Q"&QUARTER([Date]))

	annotation PBI_Id = 3cbe85704ff54de6b2dde6da77753862

