table Config_Measures
	lineageTag: 19de1b9d-964c-4e24-8984-244e8cc5d732

	/// Autogenerated description for measure 'Current_Year'.
	measure Current_Year =
			VAR yr = 2024
					VAR sys_yr = YEAR([System_date])
					RETURN
						(IF(
							ISFILTERED(Autodate[Option]),
							sys_yr,
							yr
						))
		formatString: 0
		displayFolder: Sales_Measures
		lineageTag: 1de9b4bf-ad18-4069-b7ce-8828bf56d4b2

	/// Autogenerated description for measure 'Previous_Year'.
	measure Previous_Year = [Current_Year] - 1
		formatString: 0
		displayFolder: Sales_Measures
		lineageTag: e4221358-daa5-410d-8e41-c145855577b4

	/// Autogenerated description for measure 'System_date'.
	measure System_date = NOW()
		formatString: General Date
		lineageTag: 65c38c94-d073-44a1-aacf-26aa922fd356

	/// Autogenerated description for measure 'Sel_autodate_option'.
	measure Sel_autodate_option = ISFILTERED(Autodate[Option])
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 31b355b9-2b87-4e8d-9584-562a4722c34d

	/// Autogenerated description for measure 'YTD_Month'.
	measure YTD_Month =
			VAR sysmonth = MONTH([System_date])
					VAR selected_YTD_month = SELECTEDVALUE(Manual_Calendar[MonthIndex])
					RETURN
						IF(
							ISFILTERED(Autodate[Option]),
							sysmonth,
							selected_YTD_month
						)
		formatString: 0
		displayFolder: Sales_Measures
		lineageTag: c9084c03-f7ca-4a50-91e4-2bf97bb590fd

	column Column
		formatString: 0
		lineageTag: 0880e3aa-daad-45fc-9cea-c77bf288d6b6
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Config_Measures = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 26bcd228aeb048ceb533c91008778f47

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

