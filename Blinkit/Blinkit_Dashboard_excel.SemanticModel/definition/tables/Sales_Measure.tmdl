	/// Autogenerated description for measure 'TopN_Area_by_value'.
	measure TopN_Area_by_value =
			VAR Rank_value = RANKX(
						ALL(Master_table[area]),
						[Period_Value],
						,
						DESC
					)
					VAR _rank = SELECTEDVALUE(Rank_Table[Value])
					VAR Rank_order = IF(
						Rank_value <= _rank,
						[Period_Value],
						BLANK()
					)
					RETURN
						IF(
							_rank = 0,
							[Period_Value],
							Rank_order
