table Marketing_Measures
	lineageTag: 268399c6-0580-4843-8274-e6a934929e63

	/// Autogenerated description for measure 'Marketing_Value'.
	measure Marketing_Value = SUM(Marketing[Value])
		lineageTag: 236ac957-024f-431a-be60-893329d10222

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Marketing_YTD'.
	measure Marketing_YTD =
			VAR ytd_sys_month = [YTD_Month]
					RETURN
						CALCULATE(
							[Marketing_Value],
							'Calendar'[MonthIndex] <= ytd_sys_month
						)
		lineageTag: a58afee4-a89e-4eb6-94af-e4f9a01295f4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Autogenerated description for measure 'Period_Marketing_Value'.
	measure Period_Marketing_Value =
			VAR time_filter = SELECTEDVALUE(Time_Period[Value])
					VAR selected_month = [YTD_Month]
					VAR start_index = selected_month - time_filter
					VAR time_period = CALCULATE(
						[Marketing_Value],
						'Calendar'[MonthIndex] >= start_index,
						'Calendar'[MonthIndex] < selected_month
					)
					RETURN
						IF(
							time_filter = 0,
							[Marketing_YTD],
							time_period
						)
		lineageTag: 936f2416-77ce-4d23-9622-e87149fe6255

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 6fe26738-b5df-4546-bfe8-3a121e4cb124
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition Marketing_Measures = calculated
		mode: import
		source = Row("Column", BLANK())

